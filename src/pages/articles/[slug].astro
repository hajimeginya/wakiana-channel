---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import { getAllArticles, getArticleBySlug, getArticleDisplayChips, getRelatedArticles } from '../../lib/articles';

export function getStaticPaths() {
  return getAllArticles().map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const current = article ?? getArticleBySlug(Astro.params.slug ?? '');
const relatedArticles = current ? getRelatedArticles(current) : [];

if (!current) {
  throw new Error(`Article not found: ${Astro.params.slug}`);
}
---

<BaseLayout
  title={`${current.title} | わきあなチャンネル`}
  description={current.description}
>
  <main class="content-page">
    <article class="content-panel detail-page article-detail">
      <img class="detail-art article-cover" src={current.image_url} alt={current.title} />
      <div class="page-header compact">
        <p class="eyebrow">Article</p>
        <h1>{current.title}</h1>
      </div>

      <div class="subsection">
        <div class="section-head compact">
          <div>
            <h2>出演女優</h2>
          </div>
        </div>
        <div class="tag-row">
          {current.actress_slugs.map((slug, index) => (
            <a class="chip chip-strong" href={`/actress/${slug}/`}>
              {current.actresses[index]}
            </a>
          ))}
        </div>
      </div>

      <div class="subsection">
        <div class="section-head compact">
          <div>
            <h2>タグ</h2>
          </div>
        </div>
        <div class="tag-row">
          {getArticleDisplayChips(current).map((chip) => (
            <a class={`chip ${chip.kind === 'actress' ? 'chip-strong' : ''}`} href={chip.href}>
              {chip.name}
            </a>
          ))}
        </div>
      </div>

      <div class="article-body">{current.description}</div>

      <div class="subsection">
        <div class="section-head compact">
          <div>
            <h2>関連記事</h2>
          </div>
        </div>
        <div class="related-grid">
          {relatedArticles.map((article) => (
            <a class="panel article-card" href={`/articles/${article.slug}/`}>
              <img src={article.image_url} alt={article.title} />
              <h3>{article.title}</h3>
              <div class="tag-row">
                {getArticleDisplayChips(article).slice(0, 4).map((chip) => (
                  <span class={`chip ${chip.kind === 'actress' ? 'chip-strong' : ''}`}>{chip.name}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </div>
    </article>
  </main>
</BaseLayout>
