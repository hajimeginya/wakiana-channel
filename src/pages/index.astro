---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import { armpitWorks, analWorks, featuredActresses, majorTags, newWorks, popularWorks } from '../data/sample';

const workSections = [
  { id: 'new', title: '新着作品', description: 'いま入った作品を5件だけ先に並べています。', items: newWorks },
  { id: 'ranking', title: '今週の人気作品', description: 'アクセスの集まり方が強い作品を5件まとめています。', items: popularWorks },
  { id: 'armpit', title: '脇作品', description: '脇フェチで探しやすい作品を5件厳選しています。', items: armpitWorks },
  { id: 'anal', title: 'アナル作品', description: 'アナル作品を中心に、入口になりやすい5件を並べています。', items: analWorks },
];
---

<BaseLayout title="わきあなチャンネル | 脇フェチ・アナル作品に特化したAV作品発見サイト" description="わきあなチャンネルは、脇フェチ・アナル作品に特化したAV作品発見サイトです。新着、人気、女優、タグから作品を探せます。">
  <main class="page">
    <header class="topbar">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true"></span>
        <span>わきあなチャンネル</span>
      </a>
      <nav class="nav" aria-label="Main">
        <a href="#new">新着作品</a>
        <a href="#ranking">ランキング</a>
        <a href="#armpit">脇作品</a>
        <a href="#anal">アナル作品</a>
        <a href="#actresses">女優一覧</a>
        <a href="#tags">タグ</a>
        <a href="#recommend">管理人おすすめ</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">作成中</p>
        <h1 id="hero-title">わきあなチャンネル 脇フェチ・アナル作品に特化したAV作品発見サイト</h1>
        <p>作成中のため、掲載している作品情報はサンプルデータです。</p>
        <div class="hero-actions">
          <a class="button primary" href="#new">新着作品を見る</a>
          <a class="button" href="#tags">タグから探す</a>
        </div>
      </div>

      <div class="hero-media" aria-label="作成中の案内">
        <div class="status-card">
          <strong>作成中</strong>
          <p>新着作品、ランキング、女優一覧、タグ検索を順に整えています。</p>
          <div class="status-row">
            <span class="chip chip-strong">サンプルデータ</span>
            <span class="chip chip-strong">脇作品</span>
            <span class="chip chip-strong">アナル作品</span>
          </div>
        </div>
      </div>
    </section>

    {workSections.map((section) => (
      <section class="section" id={section.id}>
        <div class="section-head">
          <div>
            <h2>{section.title}</h2>
            <p>{section.description}</p>
          </div>
        </div>

        <div class="card-grid">
          {section.items.map((item) => (
            <article class="panel work-card">
              <a class="work-link" href={`/works/${item.slug}/`}>
                <img src={item.art} alt={item.title} />
                <div class="meta">
                  <span>{item.actress}</span>
                  <span>詳細へ</span>
                </div>
                <h3>{item.title}</h3>
              </a>
              <div class="tag-row">
                {item.tags.map((tag) => (
                  <span class="chip">{tag}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}

    <section class="section" id="actresses">
      <div class="section-head">
        <div>
          <h2>人気女優</h2>
          <p>女優名から作品をたどりやすいように、入口だけを先に並べています。</p>
        </div>
      </div>
      <div class="profile-grid">
        {featuredActresses.map((actress) => (
          <article class="note profile-card">
            <strong>{actress.name}</strong>
            <span>{actress.note}</span>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="tags">
      <div class="section-head">
        <div>
          <h2>主要タグ</h2>
          <p>脇作品、アナル作品、ランキングなどの軸で探せます。</p>
        </div>
      </div>
      <div class="chip-row chip-row-large">
        {majorTags.map((tag) => (
          <span class="chip chip-strong">{tag}</span>
        ))}
      </div>
    </section>

    <section class="section" id="recommend">
      <div class="section-head">
        <div>
          <h2>管理人おすすめ</h2>
          <p>入口として見せたい作品を、わかりやすいカードでまとめています。</p>
        </div>
      </div>
      <div class="recommend-grid">
        {newWorks.slice(0, 3).map((item) => (
          <article class="panel recommend-card">
            <a class="work-link" href={`/works/${item.slug}/`}>
              <img src={item.art} alt={item.title} />
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
