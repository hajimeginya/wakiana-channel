---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import {
  getAnalWorks,
  getDisplayActressNames,
  getDisplayTagNames,
  getNewWorks,
  getPopularActresses,
  getPopularTags,
  getPopularWorks,
  getWakiWorks,
} from '../lib/catalog';
import { getLatestArticles } from '../lib/articles';

const newWorks = getNewWorks(5);
const rankingWorks = getPopularWorks(5);
const wakiWorks = getWakiWorks(5);
const analWorks = getAnalWorks(5);
const popularActresses = getPopularActresses(10);
const popularTags = getPopularTags(12);
const latestArticles = getLatestArticles(2);
---

<BaseLayout
  title="わきあなチャンネル | 脇フェチ・アナル作品に特化したAV作品発見サイト"
  description="わきあなチャンネルは、脇フェチ・アナル作品に特化したAV作品発見サイトです。"
>
  <main class="page">
    <header class="topbar">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true"></span>
        <span>わきあなチャンネル</span>
      </a>
      <nav class="nav" aria-label="Main">
        <a href="#new">新着作品</a>
        <a href="#ranking">ランキング</a>
        <a href="#waki">脇作品</a>
        <a href="#anal">アナル作品</a>
        <a href="/actress/">女優一覧</a>
        <a href="/tags/">タグ</a>
        <a href="/articles/">記事一覧</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">作成中</p>
        <h1 id="hero-title">わきあなチャンネル</h1>
        <p class="hero-lead">脇フェチ・アナル作品に特化したAV作品発見サイト</p>
        <p class="hero-note">現在このサイトは作成中です。
掲載している作品情報はサンプルデータです。</p>
        <div class="hero-actions">
          <a class="button primary" href="#new">新着作品を見る</a>
          <a class="button" href="/articles/">最新記事へ</a>
        </div>
      </div>

      <div class="hero-media" aria-label="サイト案内">
        <div class="status-card">
          <strong>作品・女優・タグから探せます</strong>
          <p>トップページは入口として整理し、作品詳細ページを経由してFANZAへ遷移する構成です。</p>
          <div class="status-row">
            <span class="chip chip-strong">新着作品</span>
            <span class="chip chip-strong">ランキング</span>
            <span class="chip chip-strong">記事</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="articles">
      <div class="section-head">
        <div>
          <h2>最新記事</h2>
          <p>サイト内の作品紹介ページです。</p>
        </div>
        <a class="button" href="/articles/">記事一覧へ</a>
      </div>
      <div class="article-grid">
        {latestArticles.map((article) => (
          <a class="panel article-card" href={`/articles/${article.slug}/`}>
            <img src={article.image_url} alt={article.title} />
            <h3>{article.title}</h3>
            <div class="tag-row">
              {article.tags.map((tag) => (
                <span class="chip">{tag.name}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="section" id="new">
      <div class="section-head">
        <div>
          <h2>新着作品</h2>
          <p>最新の作品を5件表示しています。</p>
        </div>
      </div>
      <div class="card-grid">
        {newWorks.map((item) => (
          <article class="panel work-card">
            <a class="work-link" href={`/works/${item.content_id}/`}>
              <img src={item.package_image_url} alt={item.title} />
              <h3>{item.title}</h3>
              <div class="meta">
                <span>{getDisplayActressNames(item).join(' / ')}</span>
              </div>
              <div class="tag-row">
                {getDisplayTagNames(item).slice(0, 3).map((tag) => (
                  <span class="chip">{tag}</span>
                ))}
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="ranking">
      <div class="section-head">
        <div>
          <h2>今週の人気作品</h2>
          <p>仮のランキングスコアをもとに表示しています。</p>
        </div>
      </div>
      <div class="card-grid">
        {rankingWorks.map((item) => (
          <article class="panel work-card">
            <a class="work-link" href={`/works/${item.content_id}/`}>
              <img src={item.package_image_url} alt={item.title} />
              <h3>{item.title}</h3>
              <div class="meta">
                <span>{getDisplayActressNames(item).join(' / ')}</span>
              </div>
              <div class="tag-row">
                {getDisplayTagNames(item).slice(0, 3).map((tag) => (
                  <span class="chip">{tag}</span>
                ))}
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="waki">
      <div class="section-head">
        <div>
          <h2>脇作品</h2>
          <p>脇系タグのある作品を5件表示しています。</p>
        </div>
      </div>
      <div class="card-grid">
        {wakiWorks.map((item) => (
          <article class="panel work-card">
            <a class="work-link" href={`/works/${item.content_id}/`}>
              <img src={item.package_image_url} alt={item.title} />
              <h3>{item.title}</h3>
              <div class="meta">
                <span>{getDisplayActressNames(item).join(' / ')}</span>
              </div>
              <div class="tag-row">
                {getDisplayTagNames(item).slice(0, 3).map((tag) => (
                  <span class="chip">{tag}</span>
                ))}
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="anal">
      <div class="section-head">
        <div>
          <h2>アナル作品</h2>
          <p>アナル系タグのある作品を5件表示しています。</p>
        </div>
      </div>
      <div class="card-grid">
        {analWorks.map((item) => (
          <article class="panel work-card">
            <a class="work-link" href={`/works/${item.content_id}/`}>
              <img src={item.package_image_url} alt={item.title} />
              <h3>{item.title}</h3>
              <div class="meta">
                <span>{getDisplayActressNames(item).join(' / ')}</span>
              </div>
              <div class="tag-row">
                {getDisplayTagNames(item).slice(0, 3).map((tag) => (
                  <span class="chip">{tag}</span>
                ))}
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <h2>人気女優</h2>
          <p>作品数の多い女優を10人表示しています。</p>
        </div>
        <a class="button" href="/actress/">女優一覧へ</a>
      </div>
      <div class="actress-grid featured-actress-grid">
        {popularActresses.map((actress) => (
          <a class="actress-card" href={`/actress/${actress.slug}/`}>
            <img src={actress.image_url} alt={actress.name} />
            <strong>{actress.name}</strong>
            <span>{actress.workCount}作品</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <h2>人気タグ</h2>
          <p>注目されているタグをまとめています。</p>
        </div>
        <a class="button" href="/tags/">タグ一覧へ</a>
      </div>
      <div class="tag-cloud">
        {popularTags.map((tag) => (
          <a class="chip chip-strong" href={`/tags/${tag.slug}/`}>
            {tag.name}
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
