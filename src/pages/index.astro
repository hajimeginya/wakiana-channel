---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import {
  getAnalWorks,
  getDisplayActressNames,
  getDisplayTagNames,
  getNewWorks,
  getPopularActresses,
  getPopularTags,
  getPopularWorks,
  getWakiWorks,
} from '../lib/catalog';

const newWorks = getNewWorks(5);
const rankingWorks = getPopularWorks(5);
const wakiWorks = getWakiWorks(5);
const analWorks = getAnalWorks(5);
const popularActresses = getPopularActresses(10);
const popularTags = getPopularTags(12);
---

<BaseLayout
  title="わきあなチャンネル | 脇フェチ・アナル作品に特化したAV作品発見サイト"
  description="わきあなチャンネルは、脇フェチ・アナル作品に特化したAV作品発見サイトです。"
>
  <main class="page">
    <header class="topbar">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true"></span>
        <span>わきあなチャンネル</span>
      </a>
      <nav class="nav" aria-label="Main">
        <a href="#new">新着作品</a>
        <a href="#ranking">ランキング</a>
        <a href="#waki">脇作品</a>
        <a href="#anal">アナル作品</a>
        <a href="/actress/">女優一覧</a>
        <a href="/tags/">タグ</a>
        <a href="#recommend">管理人おすすめ</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">作成中</p>
        <h1 id="hero-title">わきあなチャンネル</h1>
        <p class="hero-lead">脇フェチ・アナル作品に特化したAV作品発見サイト</p>
        <p class="hero-note">
          現在このサイトは作成中です。掲載している作品情報はサンプルデータです。
          FANZA API連携後に、データ取得部分だけ差し替えられる構成にしています。
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#new">新着作品を見る</a>
          <a class="button" href="/actress/">女優一覧へ</a>
        </div>
      </div>

      <div class="hero-media" aria-label="作成中の案内">
        <div class="status-card">
          <strong>入口を整理したトップページ</strong>
          <p>作品詳細ページを経由して、女優とタグから作品を探せます。</p>
          <div class="status-row">
            <span class="chip chip-strong">新着作品</span>
            <span class="chip chip-strong">人気作品</span>
            <span class="chip chip-strong">女優一覧</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="new">
      <div class="section-head">
        <div>
          <h2>新着作品</h2>
          <p>最新の作品を5件だけ先に並べています。</p>
        </div>
      </div>
      <div class="card-grid">
        {newWorks.map((item) => (
          <article class="panel work-card">
            <a class="work-link" href={`/works/${item.content_id}/`}>
              <img src={item.package_image_url} alt={item.title} />
              <h3>{item.title}</h3>
              <div class="meta">
                <span>{getDisplayActressNames(item).join(' / ')}</span>
              </div>
              <div class="tag-row">
                {getDisplayTagNames(item).slice(0, 3).map((tag) => (
                  <span class="chip">{tag}</span>
                ))}
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="ranking">
      <div class="section-head">
        <div>
          <h2>今週の人気作品</h2>
          <p>仮の ranking_score を使って、今の人気枠を5件並べています。</p>
        </div>
      </div>
      <div class="card-grid">
        {rankingWorks.map((item) => (
          <article class="panel work-card">
            <a class="work-link" href={`/works/${item.content_id}/`}>
              <img src={item.package_image_url} alt={item.title} />
              <h3>{item.title}</h3>
              <div class="meta">
                <span>{getDisplayActressNames(item).join(' / ')}</span>
              </div>
              <div class="tag-row">
                {getDisplayTagNames(item).slice(0, 3).map((tag) => (
                  <span class="chip">{tag}</span>
                ))}
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="waki">
      <div class="section-head">
        <div>
          <h2>脇作品</h2>
          <p>脇系のタグを持つ作品だけを5件表示しています。</p>
        </div>
      </div>
      <div class="card-grid">
        {wakiWorks.map((item) => (
          <article class="panel work-card">
            <a class="work-link" href={`/works/${item.content_id}/`}>
              <img src={item.package_image_url} alt={item.title} />
              <h3>{item.title}</h3>
              <div class="meta">
                <span>{getDisplayActressNames(item).join(' / ')}</span>
              </div>
              <div class="tag-row">
                {getDisplayTagNames(item).slice(0, 3).map((tag) => (
                  <span class="chip">{tag}</span>
                ))}
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="anal">
      <div class="section-head">
        <div>
          <h2>アナル作品</h2>
          <p>アナル系のタグを持つ作品だけを5件表示しています。</p>
        </div>
      </div>
      <div class="card-grid">
        {analWorks.map((item) => (
          <article class="panel work-card">
            <a class="work-link" href={`/works/${item.content_id}/`}>
              <img src={item.package_image_url} alt={item.title} />
              <h3>{item.title}</h3>
              <div class="meta">
                <span>{getDisplayActressNames(item).join(' / ')}</span>
              </div>
              <div class="tag-row">
                {getDisplayTagNames(item).slice(0, 3).map((tag) => (
                  <span class="chip">{tag}</span>
                ))}
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="actresses">
      <div class="section-head">
        <div>
          <h2>人気女優</h2>
          <p>人気順で10人を表示します。女優一覧は専用ページで五十音順に整理しています。</p>
        </div>
      </div>
      <div class="actress-grid featured-actress-grid">
        {popularActresses.map((actress) => (
          <a class="actress-card" href={`/actress/${actress.slug}/`}>
            <img src={actress.image_url} alt={actress.name} />
            <strong>{actress.name}</strong>
            <span>{actress.workCount}作品</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section" id="tags">
      <div class="section-head">
        <div>
          <h2>人気タグ</h2>
          <p>作品数の多いタグを優先して表示しています。</p>
        </div>
      </div>
      <div class="tag-cloud">
        {popularTags.map((tag) => (
          <a class="chip chip-strong" href={`/tags/${tag.slug}/`}>
            {tag.name}
          </a>
        ))}
      </div>
    </section>

    <section class="section" id="recommend">
      <div class="section-head">
        <div>
          <h2>管理人おすすめ</h2>
          <p>入口として見せたい作品を、わかりやすいカードでまとめています。</p>
        </div>
      </div>
      <div class="recommend-grid">
        {newWorks.slice(0, 3).map((item) => (
          <article class="panel recommend-card">
            <a class="work-link" href={`/works/${item.content_id}/`}>
              <img src={item.package_image_url} alt={item.title} />
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
