---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import { getAllArticles } from '../../lib/articles';

const articles = getAllArticles();
---

<BaseLayout
  title="記事一覧 | わきあなチャンネル"
  description="わきあなチャンネルの記事一覧。サイト内コンテンツとして作品紹介ページを掲載しています。"
>
  <main class="content-page">
    <header class="page-header">
      <p class="eyebrow">Articles</p>
      <h1>記事一覧</h1>
      <p class="page-lead">サイト内の作品紹介記事を一覧で表示します。</p>
    </header>

    <section class="article-grid" aria-label="記事一覧">
      {articles.map((article) => (
        <a class="panel article-card" href={`/articles/${article.slug}/`}>
          <img src={article.image_url} alt={article.title} />
          <h2>{article.title}</h2>
          <div class="tag-row">
            {article.tags.map((tag) => (
              <span class="chip">{tag.name}</span>
            ))}
          </div>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>
