---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import { actresses, getActressBySlug, getActressStats, getDisplayTagNames, getWorksByActressSlug } from '../../lib/catalog';

export function getStaticPaths() {
  return actresses.map((actress) => ({
    params: { slug: actress.slug },
    props: { actress },
  }));
}

const { actress } = Astro.props;
const entry = actress ?? getActressBySlug(Astro.params.slug ?? '');
const stats = entry ? getActressStats(entry.slug) : null;
const works = entry ? getWorksByActressSlug(entry.slug) : [];
const wakiWorks = works.filter((work) => work.tags.includes('waki') || work.tags.some((tag) => tag.startsWith('waki-')));
const analWorks = works.filter((work) => work.tags.includes('anal') || work.tags.some((tag) => tag.startsWith('anal-')));
---

<BaseLayout
  title={entry ? `${entry.name} | わきあなチャンネル` : '女優ページ | わきあなチャンネル'}
  description={entry ? `${entry.name} の作品一覧です。` : '女優ページです。'}
>
  <main class="content-page">
    <article class="content-panel detail-page">
      {entry && stats ? (
        <>
          <div class="actress-hero">
            <img class="actress-hero-image" src={entry.image_url} alt={entry.name} />
            <div>
              <p class="eyebrow">女優ページ</p>
              <h1>{entry.name}</h1>
              <p>{entry.kana}</p>
              <div class="stats-grid">
                <div class="stat">
                  <strong>{stats.workCount}</strong>
                  <span>出演作品数</span>
                </div>
                <div class="stat">
                  <strong>{stats.wakiCount}</strong>
                  <span>脇作品数</span>
                </div>
                <div class="stat">
                  <strong>{stats.analCount}</strong>
                  <span>アナル作品数</span>
                </div>
              </div>
            </div>
          </div>

          <section class="subsection">
            <div class="section-head compact">
              <div>
                <h2>作品一覧</h2>
              </div>
            </div>
            <div class="card-grid">
              {works.map((work) => (
                <article class="panel work-card">
                  <a class="work-link" href={`/works/${work.content_id}/`}>
                    <img src={work.package_image_url} alt={work.title} />
                    <h3>{work.title}</h3>
                    <div class="meta">
                      <span>{getDisplayTagNames(work).slice(0, 2).join(' / ')}</span>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </section>

          <section class="subsection">
            <div class="section-head compact">
              <div>
                <h2>脇作品</h2>
              </div>
            </div>
            <div class="card-grid">
              {wakiWorks.map((work) => (
                <article class="panel work-card">
                  <a class="work-link" href={`/works/${work.content_id}/`}>
                    <img src={work.package_image_url} alt={work.title} />
                    <h3>{work.title}</h3>
                  </a>
                </article>
              ))}
            </div>
          </section>

          <section class="subsection">
            <div class="section-head compact">
              <div>
                <h2>アナル作品</h2>
              </div>
            </div>
            <div class="card-grid">
              {analWorks.map((work) => (
                <article class="panel work-card">
                  <a class="work-link" href={`/works/${work.content_id}/`}>
                    <img src={work.package_image_url} alt={work.title} />
                    <h3>{work.title}</h3>
                  </a>
                </article>
              ))}
            </div>
          </section>
        </>
      ) : (
        <>
          <h1>女優が見つかりません</h1>
          <p><a href="/actress/">女優一覧へ戻る</a></p>
        </>
      )}
    </article>
  </main>
</BaseLayout>
