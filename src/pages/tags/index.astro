---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import { getPopularTags, getTagsByCategory } from '../../lib/catalog';

const wakiTags = getTagsByCategory('waki');
const analTags = getTagsByCategory('anal');
const otherTags = getTagsByCategory('other');
const popularTags = getPopularTags(12);
---

<BaseLayout title="タグ一覧 | わきあなチャンネル" description="わきあなチャンネルのタグ一覧です。">
  <main class="content-page">
    <article class="content-panel">
      <p class="eyebrow">タグ一覧</p>
      <h1>タグ一覧</h1>
      <p>タグを押すと、そのタグに該当する作品一覧ページへ移動します。</p>

      <div class="tag-cloud">
        {popularTags.map((tag) => (
          <a class="chip chip-strong" href={`/tags/${tag.slug}/`}>
            {tag.name}
          </a>
        ))}
      </div>

      <section class="subsection">
        <div class="section-head compact">
          <div>
            <h2>脇系タグ</h2>
          </div>
        </div>
        <div class="tag-card-grid">
          {wakiTags.map((tag) => (
            <a class="tag-card" href={`/tags/${tag.slug}/`}>
              <strong>{tag.name}</strong>
              <span>{tag.description}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="subsection">
        <div class="section-head compact">
          <div>
            <h2>アナル系タグ</h2>
          </div>
        </div>
        <div class="tag-card-grid">
          {analTags.map((tag) => (
            <a class="tag-card" href={`/tags/${tag.slug}/`}>
              <strong>{tag.name}</strong>
              <span>{tag.description}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="subsection">
        <div class="section-head compact">
          <div>
            <h2>その他タグ</h2>
          </div>
        </div>
        <div class="tag-card-grid">
          {otherTags.map((tag) => (
            <a class="tag-card" href={`/tags/${tag.slug}/`}>
              <strong>{tag.name}</strong>
              <span>{tag.description}</span>
            </a>
          ))}
        </div>
      </section>
    </article>
  </main>
</BaseLayout>
